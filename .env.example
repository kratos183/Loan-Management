# ─────────────────────────────────────────────────────────────
# Supabase Project Settings → API
# Dashboard: https://supabase.com/dashboard → your project
# ──────────────────────────────────────────────────────────────

# Project URL — Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key — safe to expose to the browser.
# Row Level Security (RLS) is what protects your data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Bypasses RLS. Leaking this = full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────────────────────────────
# Optional — Supabase Storage bucket for uploaded documents
# Create the bucket in Dashboard → Storage, name it `loan-documents`
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=loan-documents

# ─────────────────────────────────────────────────────────────
# Optional — third-party integrations (mocked in Phase 1)
# ─────────────────────────────────────────────────────────────
# CIBIL / credit bureau sandbox
CIBIL_PROVIDER=mock
CIBIL_API_BASE_URL=
CIBIL_API_KEY=

# Payment gateway sandbox (Razorpay / Cashfree)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Notifications (Resend email / MSG91 SMS)
NOTIFICATION_PROVIDER=console
RESEND_API_KEY=
MSG91_AUTH_KEY=

# ─────────────────────────────────────────────────────────────
# Direct database connection (optional, but recommended)
#
# Lets `npm run db:migrate` apply the SQL files straight to Postgres,
# which catches TYPE errors that a parser alone cannot — the SQL Editor
# round-trip is only needed for the very first setup.
#
# Supabase → Project → Connect → copy the URI. Use the pooler, port 6543.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SafarLoan
NEXT_PUBLIC_APP_URL=http://localhost:3000